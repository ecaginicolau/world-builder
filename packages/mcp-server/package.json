{
  "name": "world-builder-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server exposing World Builder reads/writes/intents to MCP clients (Claude Desktop, mcp inspector, ...).",
  "type": "module",
  "bin": {
    "world-builder-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "typecheck": "tsc -b --noEmit",
    "start": "node ./dist/index.js",
    "install-browser": "playwright install chromium"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@supabase/supabase-js": "^2.45.0",
    "parse5": "^7.3.0",
    "pdf-lib": "^1.17.1",
    "playwright": "1.64.0",
    "vite": "^5.4.21",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "typescript": "^5.6.3"
  }
}
